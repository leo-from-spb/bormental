"""Dr. Bormental — an IntelliJ Platform plugin, built with Bazel."""

module(
    name = "bormental",
    version = "0.1.0",
)

bazel_dep(name = "rules_kotlin", version = "2.3.20")
bazel_dep(name = "rules_java", version = "8.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

register_toolchains("//bzl:kotlin_toolchain")

# Test-only libraries. Tests are written with JUnit 5 (Jupiter); the vintage engine keeps
# JUnit 4 ones running, which is what the IntelliJ test framework is built on.
# Bazel has no JUnit 5 support of its own, hence //tools/junit5 -- see bzl/kt_tests.bzl.
JUNIT = "6.1.3"

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    # Not the default repository name 'maven': that one is shared with whatever other
    # bzlmod modules put there, and this way our lock file stays ours.
    name = "libs",
    artifacts = [
        "org.junit.jupiter:junit-jupiter:%s" % JUNIT,
        "org.junit.platform:junit-platform-launcher:%s" % JUNIT,
        "org.junit.platform:junit-platform-reporting:%s" % JUNIT,
        "org.junit.vintage:junit-vintage-engine:%s" % JUNIT,
        "junit:junit:4.13.2",
    ],
    lock_file = "//:maven_install.json",
)
use_repo(maven, "libs")

# The IntelliJ Platform we compile against: a locally installed IDE when
# BORMENTAL_IDE_HOME is set, a pinned IntelliJ IDEA Community otherwise.
# See //bzl:intellij_sdk.bzl.
intellij = use_extension("//bzl:intellij_sdk.bzl", "intellij")
use_repo(intellij, "intellij_sdk")
