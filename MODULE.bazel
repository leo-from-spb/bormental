"""Dr. Bormental — an IntelliJ Platform plugin, built with Bazel."""

module(
    name = "bormental",
    version = "0.1.0",
)

bazel_dep(name = "rules_kotlin", version = "2.3.20")
bazel_dep(name = "rules_java", version = "8.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

register_toolchains("//bzl:kotlin_toolchain")

# Test-only libraries. JUnit 4 and not 5, because the IntelliJ test framework is
# JUnit 4 based, and because JUnit 5 under Bazel needs contrib_rules_jvm, which drags
# in gazelle, rules_go and protobuf for nothing.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    # Not the default repository name 'maven': that one is shared with whatever other
    # bzlmod modules put there, and this way our lock file stays ours.
    name = "libs",
    artifacts = ["junit:junit:4.13.2"],
    lock_file = "//:maven_install.json",
)
use_repo(maven, "libs")

# The IntelliJ Platform we compile against: a locally installed IDE when
# BORMENTAL_IDE_HOME is set, a pinned IntelliJ IDEA Community otherwise.
# See //bzl:intellij_sdk.bzl.
intellij = use_extension("//bzl:intellij_sdk.bzl", "intellij")
use_repo(intellij, "intellij_sdk")
